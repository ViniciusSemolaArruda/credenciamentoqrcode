generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  FUNCIONARIO
}

enum StatusIngresso {
  DISPONIVEL
  UTILIZADO
  CANCELADO
}

enum CategoriaConvidado {
  PRESIDENCIA
  PISTA
}

// ==========================================
// USUÁRIOS
// ==========================================

model Usuario {
  id        String  @id @default(cuid())
  nome      String
  email     String  @unique
  senhaHash String
  role      Role    @default(FUNCIONARIO)
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entradas              Entrada[]
  liberacoesAutorizadas LiberacaoIngresso[] @relation("GerenteAutorizador")
  entradasConvidados    EntradaConvidado[]  @relation("EntradasConvidados")
  entradasImprensa      EntradaImprensa[]   @relation("EntradasImprensa")
}

// ==========================================
// ESCOLAS DE SAMBA
// ==========================================

model Escola {
  id     String  @id @default(cuid())
  nome   String  @unique
  sigla  String?
  limite Int     @default(20)
  ativa  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingressos Ingresso[]
}

// ==========================================
// INGRESSOS E QR CODES DAS ESCOLAS
// ==========================================

model Ingresso {
  id      String         @id @default(cuid())
  codigo  String         @unique
  qrToken String         @unique
  numero  Int
  status  StatusIngresso @default(DISPONIVEL)

  escolaId String
  escola   Escola @relation(fields: [escolaId], references: [id])

  // Um ingresso pode ter várias entradas no histórico.
  entradas Entrada[]

  // Histórico das liberações autorizadas.
  liberacoes LiberacaoIngresso[]

  // Retirada pública do QR Code.
  // Cada ingresso poderá ser retirado apenas uma vez.
  retirada RetiradaIngresso?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([escolaId, numero])
  @@index([escolaId, status])
}

// ==========================================
// RETIRADA PÚBLICA DOS QR CODES
// ==========================================

model RetiradaIngresso {
  id String @id @default(cuid())

  // Ingresso original.
  ingressoId String   @unique
  ingresso   Ingresso @relation(fields: [ingressoId], references: [id], onDelete: Restrict)

  // Dados do participante.
  nomeCompleto String
  email        String

  // Data da retirada.
  retiradoEm DateTime @default(now())

  // Controle administrativo.
  ativo Boolean @default(true)

  // Controle de envio manual por e-mail.
  emailEnviadoEm    DateTime?
  emailEnviadoPorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([retiradoEm])
}

// ==========================================
// REGISTROS DE ENTRADA DAS ESCOLAS
// ==========================================

model Entrada {
  id        String   @id @default(cuid())
  nome      String
  sobrenome String
  horario   DateTime @default(now())

  funcionarioNumero Int?

  // A entrada permanece registrada mesmo após liberação.
  ingressoId String
  ingresso   Ingresso @relation(fields: [ingressoId], references: [id])

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())

  @@index([ingressoId])
  @@index([usuarioId])
  @@index([horario])
  @@index([funcionarioNumero])
}

// ==========================================
// HISTÓRICO DE LIBERAÇÕES
// ==========================================

model LiberacaoIngresso {
  id String @id @default(cuid())

  ingressoId String
  ingresso   Ingresso @relation(fields: [ingressoId], references: [id])

  // Conta do gerente que autorizou.
  gerenteId String
  gerente   Usuario @relation("GerenteAutorizador", fields: [gerenteId], references: [id])

  // Funcionário que solicitou a liberação.
  funcionarioNumero Int

  motivo String

  autorizadoEm DateTime @default(now())

  // Identifica a entrada anterior à liberação.
  entradaAnteriorId String?

  @@index([ingressoId])
  @@index([gerenteId])
  @@index([autorizadoEm])
}

// ==========================================
// CONTROLE DO PIN DO GERENTE
// ==========================================

model ControlePinGerente {
  id           String    @id
  tentativas   Int       @default(0)
  bloqueadoAte DateTime?
  atualizadoEm DateTime  @updatedAt
}

// ==========================================
// TENTATIVAS DE PIN DO GERENTE
// ==========================================

model TentativaPinGerente {
  id                String   @id @default(cuid())
  funcionarioId     String
  funcionarioNumero Int
  ingressoId        String?
  resultado         String
  criadoEm          DateTime @default(now())

  @@index([criadoEm])
  @@index([funcionarioId])
  @@index([resultado])
}

// ==========================================
// INGRESSOS INDIVIDUAIS DE CONVIDADOS
// PRESIDÊNCIA E PISTA
// ==========================================

model IngressoConvidado {
  id        String             @id @default(cuid())
  codigo    String             @unique
  qrToken   String             @unique
  numero    Int
  categoria CategoriaConvidado
  status    StatusIngresso     @default(DISPONIVEL)

  // Cada QR Code permite apenas uma entrada.
  // Não há acompanhantes.
  entrada EntradaConvidado?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Permite PRESIDENCIA-01 e PISTA-01,
  // mas impede duplicação dentro da mesma categoria.
  @@unique([categoria, numero])
  @@index([categoria, status])
}

// ==========================================
// REGISTROS DE ENTRADA DOS CONVIDADOS
// ==========================================

model EntradaConvidado {
  id String @id @default(cuid())

  // Um registro de entrada por QR Code.
  ingressoConvidadoId String            @unique
  ingressoConvidado   IngressoConvidado @relation(fields: [ingressoConvidadoId], references: [id], onDelete: Restrict)

  // Dados da pessoa credenciada.
  nome      String
  sobrenome String

  // Funcionário 1, 2 ou 3.
  funcionarioNumero Int

  usuarioId String
  usuario   Usuario @relation("EntradasConvidados", fields: [usuarioId], references: [id])

  horario   DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([horario])
  @@index([funcionarioNumero])
}

// ==========================================
// VEÍCULOS DE IMPRENSA
// ==========================================

model VeiculoImprensa {
  id   String @id @default(cuid())
  nome String @unique
  slug String @unique

  ativo Boolean @default(true)

  // Ingressos vinculados ao veículo.
  ingressos IngressoImprensa[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// INGRESSOS E QR CODES DA IMPRENSA
// ==========================================

model IngressoImprensa {
  id      String         @id @default(cuid())
  codigo  String         @unique
  qrToken String         @unique
  numero  Int
  status  StatusIngresso @default(DISPONIVEL)

  veiculoId String
  veiculo   VeiculoImprensa @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  // Cada QR Code permite apenas uma entrada.
  entrada EntradaImprensa?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Numeração independente para cada veículo.
  @@unique([veiculoId, numero])
  @@index([veiculoId, status])
}

// ==========================================
// REGISTROS DE ENTRADA DA IMPRENSA
// ==========================================

model EntradaImprensa {
  id String @id @default(cuid())

  // Impede múltiplas entradas para o mesmo QR Code.
  ingressoImprensaId String           @unique
  ingressoImprensa   IngressoImprensa @relation(fields: [ingressoImprensaId], references: [id], onDelete: Restrict)

  // Dados do profissional de imprensa.
  nome      String
  sobrenome String

  // Funcionário 1, 2 ou 3.
  funcionarioNumero Int

  usuarioId String
  usuario   Usuario @relation("EntradasImprensa", fields: [usuarioId], references: [id])

  horario   DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([horario])
  @@index([funcionarioNumero])
}
